 "feature_notes": {
  "xberg": "1.3.10 default-features=false features=[html] -> dep:html-to-markdown-rs (features inline-images, metadata) + dep:v_htmlescape; no tokio-runtime/simd-utf8/pdf/office/email/excel/url-ingestion.",
  "serde_json_preserve_order": "xberg requires serde_json 1.0.154 with preserve_order. The default workspace resolve (no helper feature) already shows serde_json features [alloc, default, float_roundtrip, indexmap, preserve_order, raw_value, std] because rig-core 0.44.0 (normal) and rig 0.44.0 (dev) enable preserve_order. For an isolated -p brn-intake --features helper build it is newly unified by xberg.",
  "image_codecs": "html-to-markdown-rs inline-images enables image 0.25 gif/jpeg/png/bmp/webp; unified with BRN image png/jpeg, helper builds compile gif, bmp and webp decoders (added decode attack surface and size). BRN image_asset admission stays PNG/JPEG; the HTML profile refuses all image syntax before the backend.",
  "helper_union_method": "Helper-feature unions are derived statically from exact registry manifests; the single metadata run used default features (helper is not default), so xberg is not in its resolve."
 }
