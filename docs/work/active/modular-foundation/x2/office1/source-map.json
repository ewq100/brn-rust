 "corrections_to_prior_docs": [
  {
   "doc": "source1b/api.md PPTX row",
   "prior": "slide pages/hidden state",
   "actual": "PageInfo.hidden is hard-coded None and source_path is None for PPTX images (extraction/pptx/mod.rs:302,351). Hidden state, part path and picture rId are not exposed."
  },
  {
   "doc": "source1b/api.md DOCX row",
   "prior": "images include source_path/rId lookup",
   "actual": "The rId is used only to look up the relationship target; output carries the target path string, not the rId (extractors/docx.rs:1087-1177)."
  },
  {
   "doc": "source1b/resources.md ZIP9 row",
   "prior": "fixed 100 MiB XML reads can truncate",
   "actual": "DOCX refuses any member declared above 100 MiB before reading (parser.rs:2156-2195). PPTX has no such precheck, but with max_archive_size at the BRN ceiling no member can declare above it, so the 100 MiB take() is inert. Truncation needs a caller that leaves the 500 MiB default."
  }
 ],
