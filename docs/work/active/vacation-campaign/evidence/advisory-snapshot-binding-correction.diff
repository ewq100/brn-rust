+    def verify_lock_snapshot(self, item: dict, proof: dict, stage: str) -> None:
+        path = Path(proof['snapshot_path'])
+        st = path.lstat()
+        if not stat.S_ISREG(st.st_mode) or path.is_symlink():
+            raise StopRun(item['label'] + ': lock snapshot is not a regular non-symlink file')
+        digest, size = file_hash(path)
+        if size != item['lock_bytes'] or digest != item['lock_sha256']:
+            raise StopRun(item['label'] + ': lock snapshot bytes changed at ' + stage)
+        self.manifest.setdefault('snapshot_verifications', []).append({
+            'label': item['label'], 'stage': stage, 'path': str(path),
+            'bytes': size, 'sha256': digest, 'regular_nonsymlink': True})
+        self.persist()
