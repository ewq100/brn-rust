+#[tokio::test]
+async fn copilot_parent_chat_and_responses_keep_route_effort_and_send_no_output_cap() {
+    let (_root, mut request, _) = tests::fixture();
+    request.selection.provider = Provider::Copilot;
+    request.selection.model = "gpt-6-luna".into();
+    cache_tests::configure(&request, "Copilot");
+    let (scope,input) = begin(&request).unwrap();
+    let http = SequencedHttpClient::new([
+        MockHttpResponse::error(rig::http_client::StatusCode::BAD_REQUEST, r#"{"error":{"code":"unsupported_api_for_model"}}"#),
+        MockHttpResponse::success_typed(cache_tests::final_turn(), "text/event-stream"),
+    ]);
+    let answer = run_copilot(&copilot_http(http.clone()), request.selection.model, scope, &input,
+        ReasoningEffort::High, 4, CancellationToken::new(), Arc::new(|_|{})).await;
+    assert!(matches!(answer.terminal, AiTerminal::Completed), "{:?}",answer.terminal);
+    let requests=http.requests(); assert_eq!(requests.len(),2);
+    assert!(requests[0].uri.ends_with("/chat/completions"));
+    assert!(requests[1].uri.ends_with("/responses"));
+    for (i,request) in requests.iter().enumerate() {
+        let body:Value=serde_json::from_slice(&request.body).unwrap();
+        assert_eq!(body["model"],"gpt-6-luna"); assert_no_output_cap(&body);
+        assert_eq!(if i==0 { &body["reasoning_effort"] } else { &body["reasoning"]["effort"] }, "high");
+    }
+}
