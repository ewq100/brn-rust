+#[tokio::test]
+async fn exact_tool_result_admission_boundary_reaches_the_next_real_dispatch() {
+    let (_root, request, id) = tests::fixture();
+    let mut store = Store::open(&request.data_dir).unwrap();
+    let bytes = 128 * 1024;
+    owner_write(&mut store, vec![Put { id: id.clone(), expected_version: Some(1), archived:false,
+        data: RecordData::Note(Note::working("Boundary", "x".repeat(bytes))) }]);
+    let (scope, input) = begin(&request).unwrap();
+    let read = |version| read_note(&scope, ReadNoteArgs { id:id.clone(), version, start:0, max_bytes:bytes, section:false }).unwrap();
+    let result_estimate = |value| serde_json::to_vec(&rig::tool::ToolOutput::json(value)).unwrap().len() + 1024;
+    let extra = (128 * 1024 + 4096) - result_estimate(read(2));
+    assert!(extra < bytes);
+    owner_write(&mut store, vec![Put { id: id.clone(), expected_version: Some(2), archived:false,
+        data: RecordData::Note(Note::working("Boundary", format!("{}{}", "\n".repeat(extra), "x".repeat(bytes-extra)))) }]);
+    assert_eq!(result_estimate(read(3)), 128 * 1024 + 4096);
+    let model = MockCompletionModel::from_stream_turns([
+        vec![MockStreamEvent::tool_call("boundary", "read_note", json!({"id":id,"version":3,"start":0,"max_bytes":bytes,"section":false})), MockStreamEvent::final_response_with_total_tokens(1)],
+        vec![MockStreamEvent::text("Boundary admitted"), MockStreamEvent::final_response_with_total_tokens(1)],
+    ]);
+    let answer = capped(model.clone(), scope, &input, 500000).await;
+    assert!(matches!(answer.terminal, AiTerminal::Completed), "{:?}",answer.terminal);
+    assert_eq!(model.request_count(), 2);
+}
