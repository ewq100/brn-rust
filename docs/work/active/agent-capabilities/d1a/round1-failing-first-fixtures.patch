+    let answer=run_copilot(&copilot_http(http.clone()),request.selection.model,scope.clone(),&input,ReasoningEffort::High,4,CancellationToken::new(),Arc::new(|_|{})).await;
+    context_failure(&answer);assert_eq!(http.requests().len(),1);
+    let AiTerminal::Failed(error)=answer.terminal else {panic!()};
