+/// Resolve one optional part owned by this actual slide. Missing relationships
+/// are normal; malformed, ambiguous or external bindings are not associations.
+pub(super) fn parse_slide_relationship_target(
+    slide_path: &str,
+    rels_data: &[u8],
+    relationship_type: &str,
+) -> Result<Option<String>> {
+    let fail = |message: &str| XbergError::parsing(format!("PPTX slide relationship: {message}"));
+    let xml = utf8_validation::from_utf8(rels_data).map_err(|_| fail("invalid UTF-8"))?;
+    let doc = Document::parse(xml).map_err(|_| fail("malformed relationship XML"))?;
+    const PACKAGE_RELATIONSHIPS: &str = "http://schemas.openxmlformats.org/package/2006/relationships";
+    let root = doc.root_element();
+    if !root.has_tag_name((PACKAGE_RELATIONSHIPS, "Relationships")) {
+        return Err(fail("invalid package relationship namespace"));
+    }
+    let expected_type = format!("{RELATIONSHIPS_NAMESPACE}/{relationship_type}");
+    let mut selected = None;
+    let mut ids = std::collections::HashSet::new();
+    for rel in root
+        .children()
+        .filter(|n| n.has_tag_name((PACKAGE_RELATIONSHIPS, "Relationship")))
+    {
+        if let Some(id) = unqualified_attribute(rel, "Id")
+            && !ids.insert(id)
+        {
+            return Err(fail("duplicate relationship ID"));
+        }
+        if unqualified_attribute(rel, "Type") != Some(expected_type.as_str()) {
+            continue;
+        }
+        if selected.is_some() {
+            return Err(fail("ambiguous owned part relationship"));
+        }
+        if unqualified_attribute(rel, "Id").is_none_or(str::is_empty) {
+            return Err(fail("missing relationship ID"));
+        }
+        if !matches!(unqualified_attribute(rel, "TargetMode"), None | Some("Internal")) {
+            return Err(fail("external or invalid TargetMode"));
+        }
+        let target = unqualified_attribute(rel, "Target")
+            .filter(|t| !t.is_empty())
+            .ok_or_else(|| fail("missing target"))?;
+        if url::Url::parse(target).is_ok() {
+            return Err(fail("absolute URI is not an internal part target"));
+        }
+        let base = slide_path.rsplit_once('/').map_or("", |(base, _)| base);
+        selected = Some(
+            crate::extractors::security::resolve_container_entry(base, target)
+                .map_err(|_| fail("invalid internal part target"))?,
+        );
+    }
+    Ok(selected)
+}

