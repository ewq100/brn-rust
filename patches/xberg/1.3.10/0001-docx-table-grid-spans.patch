+/// Attach geometry to the exact table element without replacing its other attributes.
+fn attach_native_table_grid(
+    builder: &mut InternalDocumentBuilder,
+    index: u32,
+    table: &crate::extraction::docx::parser::Table,
+    cell_styles: &[crate::types::TableCellStyle],
+) {
+    let Some(mut grid) = table.to_native_grid(crate::extraction::docx::parser::Paragraph::runs_to_markdown) else {
+        return;
+    };
+    for cell in &mut grid.cells {
+        if let Ok(style_index) = cell_styles.binary_search_by_key(&(cell.row, cell.col), |s| (s.row, s.col)) {
+            let style = &cell_styles[style_index];
+            cell.heading_level = style.heading_level;
+            cell.style_name = style.style_name.clone();
+        }
+    }
+    if let Ok(encoded) = serde_json::to_string(&grid) {
+        builder.merge_attribute(index, crate::types::internal::NATIVE_TABLE_GRID_ATTRIBUTE, encoded);
+    }
+}
