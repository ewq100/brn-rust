+    /// Preserve parsed rectangular merge geometry alongside the unchanged dense grid.
+    /// Missing grids, ragged rows and unmatched vertical continuations keep the legacy
+    /// projection; their source layout cannot be inferred from equal or empty text.
+    pub(crate) fn to_native_grid(
+        &self,
+        render: impl Fn(&Paragraph) -> String,
+    ) -> Option<crate::types::document_structure::TableGrid> {
+        use super::table::VerticalMerge;
+        use crate::types::document_structure::{GridCell, TableGrid};
+
+        let rows = u32::try_from(self.rows.len()).ok()?;
+        let cols = u32::try_from(self.grid.as_ref()?.columns.len()).ok()?;
+        if rows == 0 || cols == 0 {
+            return None;
+        }
+        let mut cells: Vec<GridCell> = Vec::new();
+        // Only merges active in the immediately preceding row may continue.
+        // Each entry binds the exact source column and span to its one origin.
+        let mut previous: Vec<(u32, u32, usize)> = Vec::new();
+        for (row_index, row) in self.rows.iter().enumerate() {
+            let row_index = u32::try_from(row_index).ok()?;
+            let mut col = 0u32;
+            let mut active = Vec::new();
+            for cell in &row.cells {
+                let props = cell.properties.as_ref();
+                let span = props.and_then(|p| p.grid_span).unwrap_or(1);
+                let end = col.checked_add(span)?;
+                if span == 0 || end > cols {
+                    return None;
+                }
+                match props.and_then(|p| p.v_merge.as_ref()) {
+                    Some(VerticalMerge::Continue) => {
+                        let origin = previous
+                            .iter()
+                            .find(|(start, width, _)| *start == col && *width == span)?
+                            .2;
+                        let origin_cell = cells.get_mut(origin)?;
+                        origin_cell.row_span = origin_cell.row_span.checked_add(1)?;
+                        active.push((col, span, origin));
+                    }
+                    merge => {
+                        let origin = cells.len();
+                        cells.push(GridCell {
+                            content: cell
+                                .paragraphs
+                                .iter()
+                                .map(&render)
+                                .collect::<Vec<_>>()
+                                .join(" ")
+                                .trim()
+                                .to_string(),
+                            row: row_index,
+                            col,
+                            row_span: 1,
+                            col_span: span,
+                            is_header: row_index == 0,
+                            bbox: None,
+                            heading_level: None,
+                            style_name: None,
+                        });
+                        if matches!(merge, Some(VerticalMerge::Restart)) {
+                            active.push((col, span, origin));
+                        }
+                    }
+                }
+                col = end;
+            }
+            if col != cols {
+                return None;
+            }
+            previous = active;
+        }
+        Some(TableGrid { rows, cols, cells })
+    }
