+                if matches!(namespace, quick_xml::name::ResolveResult::Bound(uri) if uri.into_inner() == MATH_NAMESPACE)
+                    && local.into_inner() == expected_tag
+                {
+                    break;
+                }
+            }
             Ok(quick_xml::events::Event::Eof) => return None,
             Err(_) => return None,
             _ => {}
