new file mode 100644
index 0000000..5a0fe99
--- /dev/null
+++ b/src/extraction/docx/xml_names.rs
@@ -0,0 +1,75 @@
+//! Expanded-name queries over quick-xml's maintained namespace resolver.
+//! No event rewriting or namespace stack is implemented here.
+use crate::extraction::ooxml_constants::*;
+use quick_xml::name::{NamespaceResolver, QName, ResolveResult};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum Space {
+    Word,
+    Relationship,
+    PackageRelationship,
+    Drawing,
+    WordDrawing,
+    Picture,
+    Math,
+    Compatibility,
+    Vml,
+    Unqualified,
+    Foreign,
+}
+
+fn space(uri: Option<&str>) -> Space {
+    match uri {
+        Some(WORDPROCESSINGML_NAMESPACE | "http://purl.oclc.org/ooxml/wordprocessingml/main") => Space::Word,
+        Some(RELATIONSHIPS_NAMESPACE | "http://purl.oclc.org/ooxml/officeDocument/relationships") => {
+            Space::Relationship
+        }
+        Some(PACKAGE_RELATIONSHIPS_NAMESPACE) => Space::PackageRelationship,
+        Some(DRAWINGML_NAMESPACE) => Space::Drawing,
+        Some(WORDPROCESSINGDRAWING_NAMESPACE) => Space::WordDrawing,
+        Some(PICTURE_NAMESPACE) => Space::Picture,
+        Some("http://schemas.openxmlformats.org/officeDocument/2006/math") => Space::Math,
+        Some("http://schemas.openxmlformats.org/markup-compatibility/2006") => Space::Compatibility,
+        Some("urn:schemas-microsoft-com:vml") => Space::Vml,
+        None => Space::Unqualified,
+        _ => Space::Foreign,
+    }
+}
+
+fn resolved(result: ResolveResult<'_>) -> Space {
+    match result {
+        ResolveResult::Bound(uri) => space(Some(uri.into_inner())),
+        ResolveResult::Unbound => Space::Unqualified,
+        ResolveResult::Unknown(_) => Space::Foreign,
+    }
+}
+
+pub(super) fn element<'n>(ns: &NamespaceResolver, name: QName<'n>) -> (Space, &'n str) {
+    let (uri, local) = ns.resolve_element(name);
+    (resolved(uri), local.into_inner())
+}
+
+pub(super) fn attribute<'n>(ns: &NamespaceResolver, name: QName<'n>) -> (Space, &'n str) {
+    // Default element namespaces never qualify unprefixed attributes.
+    let (uri, local) = ns.resolve_attribute(name);
+    (resolved(uri), local.into_inner())
+}
+
+pub(super) fn word_node_name<'a>(node: &'a roxmltree::Node<'_, '_>) -> &'a str {
+    if space(node.tag_name().namespace()) == Space::Word {
+        node.tag_name().name()
+    } else {
+        ""
+    }
+}
+
+pub(super) fn word_attribute<'a>(node: &'a roxmltree::Node<'_, '_>, local: &str) -> Option<&'a str> {
+    node.attributes()
+        .find(|a| space(a.namespace()) == Space::Word && a.name() == local)
+        .map(|a| a.value())
+}
+
+pub(super) fn word_element<'n>(ns: &NamespaceResolver, name: QName<'n>) -> &'n str {
+    let (space, local) = element(ns, name);
+    if space == Space::Word { local } else { "" }
+}
