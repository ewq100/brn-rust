(version 1)
(deny default)
(allow process-fork)
(allow sysctl-read)
(allow file-map-executable (literal "<pinned-helper>") (subpath "/System/Library") (subpath "/usr/lib"))
(allow file-read* (subpath "/System/Library") (subpath "/System/Volumes/Preboot") (subpath "/private/preboot") (subpath "/usr/lib") (subpath "/private/var/db/dyld") (literal "<pinned-helper>") (subpath "<per-run-input-root>"))
(allow file-write* (subpath "<per-run-input-root>/out"))
(allow file-read* file-write* (literal "/dev/null"))
