{
  "mime_detection_policy": "prefer_content",
  "use_cache": false,
  "enable_quality_processing": false,
  "ocr": null,
  "force_ocr": false,
  "ocr_strategy": {
    "mode": "auto"
  },
  "disable_ocr": true,
  "ocr_near_empty_fallback": null,
  "ocr_scanned_page_quality_gate": null,
  "ocr_embedded_images": null,
  "chunking": null,
  "content_filter": null,
  "images": {
    "extract_images": true,
    "target_dpi": 300,
    "max_image_dimension": 4096,
    "inject_placeholders": false,
    "auto_adjust_dpi": false,
    "min_dpi": 72,
    "max_dpi": 600,
    "max_images_per_page": 100,
    "classify": false,
    "include_page_rasters": false,
    "run_ocr_on_images": false,
    "ocr_text_only": false,
    "append_ocr_text": true,
    "output_format": {
      "type": "native"
    },
    "include_data_base64": false
  },
  "pdf_options": {
    "extract_images": true,
    "extract_tables": false,
    "passwords": null,
    "extract_metadata": true,
    "hierarchy": null,
    "extract_annotations": false,
    "top_margin_fraction": null,
    "bottom_margin_fraction": null,
    "allow_single_column_tables": false,
    "ocr_inline_images": false,
    "extract_form_fields": true,
    "reading_order": false,
    "backend": "native"
  },
  "token_reduction": null,
  "language_detection": null,
  "pages": {
    "extract_pages": true,
    "insert_page_markers": false,
    "marker_format": "\n\n<!-- PAGE {page_num} -->\n\n",
    "keep_native_content": true
  },
  "postprocessor": null,
  "html_options": null,
  "html_output": null,
  "extraction_timeout_secs": 30,
  "max_concurrent_extractions": null,
  "result_format": "unified",
  "security_limits": {
    "max_archive_size": 524288000,
    "max_compression_ratio": 100,
    "max_files_in_archive": 10000,
    "max_nesting_depth": 1024,
    "max_entity_length": 1048576,
    "max_content_size": 104857600,
    "max_iterations": 10000000,
    "max_xml_depth": 1024,
    "max_table_cells": 100000,
    "max_pages": 20
  },
  "max_embedded_file_bytes": 52428800,
  "output_format": "plain",
  "escape_markdown": true,
  "table_anchors": false,
  "jupyter_cell_rendering": "both",
  "apply_notebook_cell_tags": true,
  "use_layout_for_markdown": false,
  "include_document_structure": false,
  "strict_parse": false,
  "acceleration": null,
  "cache_namespace": null,
  "cache_ttl_secs": null,
  "email": null,
  "csv": null,
  "geojson": null,
  "concurrency": null,
  "url": {
    "mode": "auto",
    "document_url_pattern": null,
    "max_document_urls_per_result": 100,
    "max_total_urls": 1000,
    "allow_local_file_inputs": true,
    "allow_file_uris": true
  },
  "max_archive_depth": 3
}